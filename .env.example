# Telegram
BOT_TOKEN=
ADMIN_IDS=
# Telegram ID тестировщиков через запятую. Они всё равно должны быть подписаны на ОП-канал.
BETA_TESTER_IDS=

# Доступ на время закрытого бета-теста
REQUIRED_CHANNEL=@thechanneldesk
REQUIRED_CHANNEL_URL=https://t.me/thechanneldesk
ZBT_ENABLED=true

# Database (Supabase pooler)
DATABASE_URL=

# Mini App
MINI_APP_URL=https://channeldesk.vercel.app

# Необязательно: сохранять пересланные медиа в Supabase Storage.
# Если не указать, черновик всё равно создастся, а publisher использует Telegram file_id.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Daily morning Pulse in Telegram
PULSE_ENABLED=true
PULSE_HOUR=9
PULSE_MINUTE=0
